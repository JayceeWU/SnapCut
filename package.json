{
  "name": "snapcut",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13 <23"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "doctor": "npx expo-doctor@latest",
    "format": "prettier --check .",
    "cpd": "jscpd app src modules --config .jscpd.json --no-colors --no-tips",
    "audit": "node scripts/audit-prohibited.mjs",
    "prebuild:clean": "expo prebuild --clean"
  },
  "dependencies": {
    "expo": "~57.0.13",
    "expo-build-properties": "~57.0.11",
    "expo-constants": "~57.0.11",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.12",
    "expo-file-system": "~57.0.4",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-navigation-bar": "~57.0.2",
    "expo-router": "~57.0.13",
    "expo-sharing": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "jest-expo": "~57.0.4",
    "jscpd": "^5.0.14",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
